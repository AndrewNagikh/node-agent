# Copy to docker/.env
#
#   cp docker/.env.example docker/.env

# --- nodes: the only setting that matters --------------------------------
# Where the orchestrator is reachable from this machine.
ORCHESTRATOR=http://192.0.2.10:9000

# --- optional ------------------------------------------------------------
# Node id. Defaults to the machine's hostname, which is already unique.
# NODE_ID=node-a

# Where layer shards are stored on the HOST. Keep this on a disk with room --
# a 70B model is tens of gigabytes, and this directory is what makes a
# container restart free instead of a re-download.
# MODELS_DIR=/var/lib/node-agent/models

# Ports. Defaults suit one orchestrator and one agent per machine.
# ORCHESTRATOR_PORT=9000
# NODE_PORT=9001

# Only when IP detection picks the wrong interface (several NICs), or when
# running without host networking, where it cannot work at all.
# ADVERTISE_HOST=192.0.2.11

# Needed only for gated Hugging Face repositories.
# HF_TOKEN=hf_...
